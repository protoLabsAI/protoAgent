---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductOverview from '../components/ProductOverview.astro';
const outcomes = [
  { title: 'Work with your files', body: 'Bring documents into a conversation, create downloadable results, and give the agent access to selected work folders.', href: '/docs/guides/documents-and-files', label: 'Files and documents' },
  { title: 'Keep useful context', body: 'Save preferences and reference material for later. Inspect the memory and sources that reach a turn, and correct what the agent remembers.', href: '/docs/guides/manage-memory', label: 'Memory you can inspect' },
  { title: 'Give recurring work a home', body: 'Use schedules for timed jobs, watches for events, and goals for work that needs to continue. Follow progress and stop work from the app.', href: '/docs/guides/automate-work', label: 'Choose an automation' },
  { title: 'Connect the tools you use', body: 'Add a reusable skill, connect an MCP server, or install a plugin with its own tools and interface. Enable the capabilities your task needs.', href: '/docs/guides/use-protoagent#tools-and-integrations', label: 'Connect and extend' },
];
const paths = [
  { title: 'Use the app', body: 'Install, connect a model, and get your first reply. Then work with files, tools, and memory.', href: '/docs/tutorials/first-agent', label: 'Start here' },
  { title: 'Build on it', body: 'Write a skill or plugin, add a custom view, and keep your domain logic alongside your code.', href: '/docs/guides/extend', label: 'Builder guides' },
  { title: 'Operate your agents', body: 'Run a headless server, manage separate instances, connect a fleet, and inspect traces and costs.', href: '/docs/guides/deploy-and-operate', label: 'Operator guides' },
];
---
<BaseLayout title="protoAgent — put your AI agent to work" description="Chat, work with files, keep useful context, and automate tasks with an AI agent you control. Desktop app for macOS, Windows, and Linux; local or hosted models.">
  <section class="pl-hero"><div class="pl-container">
    <p class="pl-eyebrow">Open source · desktop and browser · your model connections</p>
    <h1>Put your AI agent <span class="pl-gradient-text">to work.</span></h1>
    <p class="pl-lead">Chat, work with files, remember useful context, and automate recurring tasks.
      Start with a desktop app, connect your own model, and add tools as you need them.
      Grow into multiple agents when the work calls for it.</p>
    <div class="pl-hero__cta">
      <a href="/download" class="pl-btn pl-btn--primary">Download protoAgent</a>
      <a href="/use-cases" class="pl-btn">Explore what you can do</a>
    </div>
    <p class="meta-note">Public beta for macOS, Windows, and Linux. Bring a supported subscription, API connection, or local model endpoint.</p>
    <ProductOverview />
  </div></section>
  <section class="pl-section"><div class="pl-container">
    <p class="pl-eyebrow">Everyday work</p><h2 class="pl-heading">More than a conversation</h2>
    <div class="pl-deliverables">{outcomes.map((item) => <div class="pl-deliverable">
      <h3 class="pl-deliverable__title">{item.title}</h3><p class="pl-deliverable__body">{item.body}</p>
      <a href={item.href}>{item.label} →</a>
    </div>)}</div>
    <div class="actions"><a href="/features" class="pl-btn">See the full feature set</a></div>
  </div></section>
  <section class="pl-section"><div class="pl-container">
    <p class="pl-eyebrow">Get started</p><h2 class="pl-heading">From install to a useful first task</h2>
    <ol class="start-steps">
      <li><strong>Install the app.</strong> The desktop download includes the server and console; Python and Node are not needed just to chat.</li>
      <li><strong>Connect a model.</strong> Choose a supported Claude or ChatGPT / Codex subscription, or an OpenAI-compatible hosted or local endpoint. Test it in setup.</li>
      <li><strong>Give it a bounded task.</strong> Ask a question, attach a document, or choose a starter archetype. Add permissions and integrations as the task needs them.</li>
    </ol>
    <div class="actions"><a href="/docs/tutorials/first-agent" class="pl-btn pl-btn--primary">Follow the first-agent tutorial</a></div>
  </div></section>
  <section class="pl-section"><div class="pl-container">
    <p class="pl-eyebrow">Choose your path</p>
    <div class="pl-deliverables">{paths.map((item) => <div class="pl-deliverable">
      <h2 class="pl-deliverable__title">{item.title}</h2><p class="pl-deliverable__body">{item.body}</p><a href={item.href}>{item.label} →</a>
    </div>)}</div>
  </div></section>
  <section class="pl-section"><div class="pl-container">
    <p class="pl-eyebrow">Before you start</p>
    <div class="faq-list">
      <details><summary>Do I need a model subscription?</summary><p>You need a working model connection. That can be a supported subscription, a hosted API, or a local endpoint you run. protoAgent is MIT-licensed; provider charges and infrastructure costs are separate.</p></details>
      <details><summary>Does everything stay on my machine?</summary><p>The agent runs where you install it and keeps its local state there. Prompts and selected context go to your configured model; tools and integrations can contact other services. Choose local models and review enabled capabilities to match your requirements.</p></details>
      <details><summary>Can I use it from my phone?</summary><p>Yes, through the browser console connected to a running, reachable agent. Pair over your LAN or a private network such as Tailscale. It is not an offline mobile app. <a href="/docs/guides/phone-access">Phone setup →</a></p></details>
      <details><summary>Can I run it without the desktop app?</summary><p>Yes. Run the Python package, a source checkout, or a headless deployment. The <a href="/docs/tutorials/first-agent">setup guide</a> covers the package and source routes; <a href="/docs/guides/headless">deployment guides</a> cover servers.</p></details>
    </div>
  </div></section>
</BaseLayout>
