---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchLatestDesktopRelease } from '../lib/desktop-release';

const repo = 'https://github.com/protoLabsAI/protoAgent';

// Buttondown newsletter — gates the not-yet-public platform (Linux) behind a
// notify-me signup until that build is tested here. Set this to the account's
// Buttondown username.
const BUTTONDOWN_USER = 'protoLabsAI';

// Desktop and source/server releases share one tag sequence but ship on separate
// cadences, so "newest changelog entry" is NOT "newest desktop build" (#2514).
// This resolves the newest release that actually carries both installers and
// links the assets' own URLs; it throws — failing the build — rather than let a
// dead download link go out. Needs network (and GITHUB_TOKEN in CI, see
// marketing-deploy.yml); other pages still render in `astro dev` if it fails.
const desktop = await fetchLatestDesktopRelease();
const { dmgUrl, setupExeUrl } = desktop;

const subscribeAction = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`;
const subscribePopup = `https://buttondown.com/${BUTTONDOWN_USER}`;

const macRequirements = [
  'Apple Silicon (M1 or later)',
  'macOS 13 Ventura or newer',
  'A model gateway — connect an OpenAI-compatible endpoint or key in setup',
];

const macInstall = [
  'Download the .dmg above.',
  'Open it and drag protoAgent to Applications.',
  'Launch protoAgent — it starts its own bundled server, nothing else to install.',
  'The setup wizard connects your model and you’re live.',
];

const winRequirements = [
  'Windows 11, 64-bit (x64)',
  'A model gateway or subscription — connect an OpenAI-compatible endpoint, an API key, or your ChatGPT/Claude plan in setup',
];

const winInstall = [
  'Download the setup.exe above and run it.',
  'Launch protoAgent — it starts its own bundled server, nothing else to install.',
  'The setup wizard connects your model and you’re live.',
];
---

<BaseLayout
  title="Download protoAgent"
  description="Download protoAgent — the lean, A2A-native operator agent for macOS and Windows. Linux coming soon."
>
  <!-- Detect the OS before paint so the right block is visible with no flash. -->
  <script is:inline>
    (function () {
      function detect() {
        var ua = (navigator.userAgent || '').toLowerCase();
        var plat =
          ((navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform ||
            '').toLowerCase();
        var s = plat + ' ' + ua;
        // iPadOS reports as a Mac in desktop Safari — touch-Macs can't run the
        // desktop app, so route them to the "other" (notify-me) experience.
        if (/mac/.test(s) && navigator.maxTouchPoints > 1) return 'other';
        if (/iphone|ipad|ipod/.test(s)) return 'other';
        if (/mac/.test(s)) return 'mac';
        if (/win/.test(s)) return 'windows';
        if (/linux|android|cros/.test(s)) return 'linux';
        return 'other';
      }
      try {
        document.documentElement.setAttribute('data-os', detect());
      } catch (e) {
        document.documentElement.setAttribute('data-os', 'mac');
      }
    })();
  </script>

  <section class="pl-hero">
    <div class="pl-container">
      <p class="pl-eyebrow">Download</p>
      <h1>protoAgent on your desktop</h1>
      <div class="meta-row">
        <span class="pl-badge">{desktop.tag}</span>
        <span class="pl-badge">beta</span>
        <span class="pl-badge">{desktop.date}</span>
      </div>

      <!-- ===== macOS ===== -->
      <div class="dl-os dl-os-mac">
        <div class="pl-hero__cta">
          <a href={dmgUrl} class="pl-btn pl-btn--primary">Download for macOS (.dmg)</a>
          <a href={setupExeUrl} class="pl-btn">Windows (setup.exe)</a>
        </div>
        <p class="meta-note">Apple Silicon · signed &amp; notarized · updates itself in place.</p>
      </div>

      <!-- ===== Windows ===== -->
      <div class="dl-os dl-os-windows">
        <div class="pl-hero__cta">
          <a href={setupExeUrl} class="pl-btn pl-btn--primary">Download for Windows (setup.exe)</a>
          <a href={dmgUrl} class="pl-btn">macOS (.dmg)</a>
        </div>
        <p class="meta-note">Windows 11 x64 · unsigned build · updates itself in place.</p>
      </div>

      <!-- ===== Linux / other: no desktop build yet ===== -->
      <div class="dl-os dl-os-other">
        <p class="pl-lead">
          No Linux desktop build yet. It compiles on every release but is still being tested
          before we hand it out. Leave your email below and we’ll tell you the moment it’s
          ready — or run protoAgent from source today.
        </p>
        <div class="pl-hero__cta">
          <a href={repo} target="_blank" rel="noopener noreferrer" class="pl-btn pl-btn--primary">Run it from source</a>
          <a href={dmgUrl} class="pl-btn">macOS (.dmg)</a>
          <a href={setupExeUrl} class="pl-btn">Windows (setup.exe)</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== macOS: requirements + install ===== -->
  <div class="dl-os dl-os-mac">
    <section class="pl-section">
      <div class="pl-container">
        <p class="pl-eyebrow">System requirements — macOS</p>
        <div class="pl-checks">
          {macRequirements.map((r) => (
            <div class="pl-check">
              <span class="pl-check__mark" aria-hidden="true">—</span>
              <span>{r}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pl-section">
      <div class="pl-container">
        <p class="pl-eyebrow">Installation</p>
        <div class="pl-steps">
          {macInstall.map((step, i) => (
            <div class="pl-step">
              <div class="pl-step__num">{i + 1}</div>
              <div class="pl-step__body">{step}</div>
            </div>
          ))}
        </div>
        <div class="pl-deliverable note-block">
          <div class="pl-deliverable__title">Signed &amp; notarized by Apple</div>
          <div class="pl-deliverable__body">
            Opens cleanly, no Gatekeeper workaround. protoAgent is in public beta and updates
            itself in place; expect frequent releases.
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ===== Windows: requirements + install ===== -->
  <div class="dl-os dl-os-windows">
    <section class="pl-section">
      <div class="pl-container">
        <p class="pl-eyebrow">System requirements — Windows</p>
        <div class="pl-checks">
          {winRequirements.map((r) => (
            <div class="pl-check">
              <span class="pl-check__mark" aria-hidden="true">—</span>
              <span>{r}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pl-section">
      <div class="pl-container">
        <p class="pl-eyebrow">Installation</p>
        <div class="pl-steps">
          {winInstall.map((step, i) => (
            <div class="pl-step">
              <div class="pl-step__num">{i + 1}</div>
              <div class="pl-step__body">{step}</div>
            </div>
          ))}
        </div>
        <div class="pl-deliverable note-block">
          <div class="pl-deliverable__title">Unsigned build — expect a SmartScreen prompt</div>
          <div class="pl-deliverable__body">
            There’s no Windows code-signing certificate yet, so both the installer and the first
            launch trigger "Windows protected your PC." Click <strong>More info → Run anyway</strong> —
            that’s expected for this build, not a sign of tampering. protoAgent is in public beta
            and updates itself in place; expect frequent releases.
            <div class="note-block__link">
              <a href="/docs/guides/windows-desktop" target="_blank" rel="noopener noreferrer">Full install, data-location &amp; recovery guide →</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ===== Mailing list (shown to everyone) ===== -->
  <section class="pl-section">
    <div class="pl-container">
      <p class="pl-eyebrow">Get notified about Linux</p>
      <p class="pl-section-intro">
        The desktop app ships for macOS and Windows; Linux is still in testing. Leave your email
        and we’ll let you know the moment it ships.
      </p>
      <form
        action={subscribeAction}
        method="post"
        target="popupwindow"
        onsubmit={`window.open('${subscribePopup}', 'popupwindow')`}
        class="embeddable-buttondown-form subscribe-form"
      >
        <label for="bd-email" class="visually-hidden">Email</label>
        <input type="email" name="email" id="bd-email" required placeholder="you@example.com" class="pl-input" />
        <button type="submit" class="pl-btn pl-btn--primary">Notify me</button>
      </form>
      <p class="meta-note">No spam — release announcements only. Unsubscribe anytime.</p>
    </div>
  </section>

  <!-- ===== Build from source (shown to everyone) ===== -->
  <section class="pl-section">
    <div class="pl-container">
      <p class="pl-eyebrow">Prefer to run it yourself?</p>
      <p class="pl-section-intro">
        protoAgent is open source — clone
        <a href={repo} target="_blank" rel="noopener noreferrer">the repo</a> and run the console
        + server locally (<code>npm ci</code> then <code>python -m server</code>). The
        <a href="/docs/tutorials/first-agent" target="_blank" rel="noopener noreferrer">first-agent tutorial</a>
        walks through it. Runs anywhere Python does — macOS, Linux, or Windows.
      </p>
      <p class="endnote endnote--flush">
        <a href="/changelog">View full release history →</a>
      </p>
    </div>
  </section>

  <style is:global>
    /* OS-gated blocks — the inline head script sets data-os on <html>. */
    .dl-os {
      display: none;
    }
    :root[data-os='mac'] .dl-os-mac {
      display: block;
    }
    :root[data-os='windows'] .dl-os-windows {
      display: block;
    }
    :root[data-os='linux'] .dl-os-other,
    :root[data-os='other'] .dl-os-other {
      display: block;
    }
    /* No-JS / pre-detection fallback: show the Mac download (the shipping platform). */
    :root:not([data-os]) .dl-os-mac {
      display: block;
    }
  </style>
</BaseLayout>
