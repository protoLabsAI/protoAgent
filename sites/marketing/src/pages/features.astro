---
import BaseLayout from '../layouts/BaseLayout.astro';
const groups = [
  {
    "id": "work",
    "title": "Work in the app",
    "items": [
      {
        "title": "Chat that you can steer",
        "body": "Stream replies, change the model for a conversation, and steer ongoing work. Use the command palette to reach app actions.",
        "href": "/docs/guides/react-tauri-ui"
      },
      {
        "title": "Files and deliverables",
        "body": "Attach material to a chat, work in registered folders, and download generated files. Document creation on desktop can require the optional Python runtime.",
        "href": "/docs/guides/documents-and-files"
      },
      {
        "title": "Rich answers and document previews",
        "body": "View supported tables, charts, diagrams, and interactive artifacts alongside the conversation. Open generated documents in the Artifact panel, review versions, and download the result you want to keep.",
        "href": "/docs/guides/documents-and-files"
      },
      {
        "title": "Inspectable memory and knowledge",
        "body": "Keep standing preferences, past-session context, and reference material. Review injections and correct saved facts. Optional embeddings add semantic retrieval to keyword search.",
        "href": "/docs/guides/manage-memory"
      },
      {
        "title": "Your model connections",
        "body": "Connect hosted or local OpenAI-compatible endpoints and supported subscription logins. Select the agent model or override it for one chat.",
        "href": "/docs/guides/model-connections"
      },
      {
        "title": "Use another device",
        "body": "Pair the browser console on a phone with a reachable running agent. LAN and private-network access let you continue with the same agent and data.",
        "href": "/docs/guides/phone-access"
      }
    ]
  },
  {
    "id": "automate",
    "title": "Automate with the right mechanism",
    "items": [
      {
        "title": "Goals and progress",
        "body": "Give sustained work an objective, follow its progress, and stop it when needed. Verification behavior depends on the goal and any configured verifier.",
        "href": "/docs/guides/goal-mode"
      },
      {
        "title": "Schedules and watches",
        "body": "Run work at a time or react to an event. Choose the trigger that fits the job and inspect its state instead of hiding it in a chat instruction.",
        "href": "/docs/guides/watches"
      },
      {
        "title": "Workflows and approval gates",
        "body": "Define ordered steps and subagent work for repeatable processes. Include gates where a person needs to approve before the workflow continues.",
        "href": "/docs/guides/workflows"
      }
    ]
  },
  {
    "id": "extend",
    "title": "Build a workspace for your domain",
    "items": [
      {
        "title": "Skills and starter archetypes",
        "body": "Load reusable procedures when relevant. Start with a persona and capability bundle for a role, then adapt it to your codebase or work.",
        "href": "/docs/guides/fleet#bundles-and-archetypes"
      },
      {
        "title": "Plugins and custom views",
        "body": "Install tools, skills, routes, and console views from a plugin. Bundled capabilities and external plugins have separate enable/install paths.",
        "href": "/docs/guides/plugin-registry"
      },
      {
        "title": "MCP connections",
        "body": "Connect external tool servers and test the connection in the app. Available tools and authentication depend on the server you choose.",
        "href": "/docs/guides/mcp"
      },
      {
        "title": "Read code beside the conversation",
        "body": "Inspect files and diffs in the code pane, follow a delegate's edits, or open a file in your configured editor. Keep the evidence close to the explanation.",
        "href": "/docs/guides/react-tauri-ui#the-code-pane"
      },
      {
        "title": "Coding-agent delegates",
        "body": "Hand coding tasks to a configured ACP coding agent such as Claude Code, Codex, Gemini CLI, or protoCLI, and inspect the returned work.",
        "href": "/docs/guides/coding-agents"
      }
    ]
  },
  {
    "id": "operate",
    "title": "Operate one agent or a fleet",
    "items": [
      {
        "title": "Separate agents and shared oversight",
        "body": "Create agents with their own workspaces and manage them through the console or Fleet Deck. Configure delegation and optional shared knowledge deliberately.",
        "href": "/docs/guides/fleet"
      },
      {
        "title": "Headless and protocol access",
        "body": "Run a server without a desktop window. Use its A2A interface or OpenAI-compatible API to connect clients and other agents.",
        "href": "/docs/guides/headless"
      },
      {
        "title": "Costs, traces, and recovery",
        "body": "Inspect reported usage and traces, diagnose failed turns, and back up local agent state. Cost availability depends on the model/provider metadata.",
        "href": "/docs/guides/observability"
      },
      {
        "title": "Explicit access boundaries",
        "body": "Configure project access, command approvals, and fetch-host rules. These application controls are not an OS sandbox; use an isolation layer for untrusted execution.",
        "href": "/docs/guides/sandboxing"
      }
    ]
  }
];
---
<BaseLayout title="Features — protoAgent" description="Explore protoAgent's chat, files, memory, model connections, automation, plugins, coding delegates, and fleet operations.">
  <section class="pl-hero"><div class="pl-container">
    <p class="pl-eyebrow">Features</p><h1>From everyday work to a fleet of agents</h1>
    <p class="pl-lead">Use the app for the task in front of you. Add persistent context, repeatable processes, and integrations as the work grows.</p>
    <nav class="actions" aria-label="Feature sections">{groups.map((g) => <a class="pl-btn" href={'#'+g.id}>{g.title}</a>)}</nav>
  </div></section>
  {groups.map((group) => <section class="pl-section" id={group.id}><div class="pl-container">
    <h2 class="pl-heading">{group.title}</h2>
    {group.items.map((item) => <div class="pl-row"><div class="pl-row__label"><a href={item.href}>Guide →</a></div><div>
      <h3 class="pl-row__name">{item.title}</h3><p class="pl-row__desc">{item.body}</p>
    </div></div>)}
  </div></section>)}
  <section class="pl-section"><div class="pl-container">
    <p class="pl-eyebrow">Under the hood</p><p class="pl-section-intro">protoAgent is built on LangGraph, with a React console and a native desktop shell. Its A2A interface connects agents; plugins keep domain-specific capabilities outside the core. The source and technical contracts are available when you need to go deeper.</p>
    <div class="actions"><a href="/download" class="pl-btn pl-btn--primary">Get protoAgent</a><a href="/docs/explanation/a2a-protocol" class="pl-btn">A2A interface</a><a href="https://github.com/protoLabsAI/protoAgent" class="pl-btn">Explore the source</a></div>
  </div></section>
</BaseLayout>
