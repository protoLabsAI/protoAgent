---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogEntries from '../components/ChangelogEntries.astro';
import changelog from '../../data/changelog.json';

const releases = 'https://github.com/protoLabsAI/protoAgent/releases';

// Group the (already newest-first) flat list into year-month buckets, keeping each
// entry's global index (startIndex) so only the true first release overall keeps
// the "latest" badge — not the first of each month.
interface Group {
  key: string;
  label: string;
  entries: typeof changelog;
  startIndex: number;
}

function monthLabel(key: string): string {
  const [y, m] = key.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const groups: Group[] = [];
changelog.forEach((entry, i) => {
  const key = entry.date.slice(0, 7); // "2026-08"
  const last = groups[groups.length - 1];
  if (!last || last.key !== key) {
    groups.push({ key, label: monthLabel(key), entries: [entry], startIndex: i });
  } else {
    last.entries.push(entry);
  }
});

const [currentMonth, ...priorMonths] = groups;
---

<BaseLayout
  title="Changelog — protoAgent"
  description="Release history for protoAgent — the LangGraph + A2A agent template."
>
  <section class="pl-hero">
    <div class="pl-container">
      <p class="pl-eyebrow">Changelog</p>
      <h1>Every release, newest first</h1>
    </div>
  </section>

  <section class="pl-section">
    <div class="pl-container">
      {currentMonth && <ChangelogEntries entries={currentMonth.entries} startIndex={currentMonth.startIndex} />}

      {priorMonths.length > 0 && (
        <div class="month-archive">
          {priorMonths.map((group) => (
            <details class="month">
              <summary class="month__summary">
                <span class="month__label">{group.label}</span>
                <span class="month__meta">
                  <span class="pl-count">{group.entries.length}</span>
                  <svg class="month__chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M7 5l6 5-6 5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <div class="month__body">
                <ChangelogEntries entries={group.entries} startIndex={group.startIndex} />
              </div>
            </details>
          ))}
        </div>
      )}

      <p class="endnote">
        Full release notes + source on <a href={releases} target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </div>
  </section>
</BaseLayout>
