---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogEntries from '../components/ChangelogEntries.astro';
import changelog from '../../data/changelog.json';

const releases = 'https://github.com/protoLabsAI/protoAgent/releases';

// Group the (already newest-first) flat list into year-month buckets, keeping each
// entry's global index (startIndex) so only the true first release overall keeps
// the "latest" badge — not the first of each month.
interface Group {
  key: string;
  label: string;
  entries: typeof changelog;
  startIndex: number;
}

function monthLabel(key: string): string {
  const [y, m] = key.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const groups: Group[] = [];
changelog.forEach((entry, i) => {
  const key = entry.date.slice(0, 7); // "2026-08"
  const last = groups[groups.length - 1];
  if (!last || last.key !== key) {
    groups.push({ key, label: monthLabel(key), entries: [entry], startIndex: i });
  } else {
    last.entries.push(entry);
  }
});

const [currentMonth, ...priorMonths] = groups;
---

<BaseLayout
  title="Changelog — protoAgent"
  description="Release history for protoAgent — the LangGraph + A2A agent template."
>
  <div class="max-w-2xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold mb-2">Changelog</h1>
    <p class="text-zinc-400 mb-16 text-lg">Every release, newest first.</p>

    {currentMonth && <ChangelogEntries entries={currentMonth.entries} startIndex={currentMonth.startIndex} />}

    {priorMonths.length > 0 && (
      <div class="mt-12 space-y-3">
        {priorMonths.map((group) => (
          <details class="group rounded-lg border" style="border-color: var(--pl-color-border);">
            <summary
              class="flex items-center justify-between gap-3 px-4 py-3 cursor-pointer select-none list-none marker:hidden [&::-webkit-details-marker]:hidden"
            >
              <span class="font-medium text-zinc-300">{group.label}</span>
              <span class="flex items-center gap-2">
                <span class="text-xs text-zinc-500">{group.entries.length} release{group.entries.length === 1 ? '' : 's'}</span>
                <svg
                  class="w-4 h-4 text-zinc-500 transition-transform duration-150 group-open:rotate-90"
                  viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"
                >
                  <path d="M7 5l6 5-6 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>
            <div class="px-4 pb-6 pt-2">
              <ChangelogEntries entries={group.entries} startIndex={group.startIndex} />
            </div>
          </details>
        ))}
      </div>
    )}

    <div class="mt-16 pt-8 border-t border-white/5">
      <p class="text-zinc-500 text-sm">
        Full release notes + source on{' '}
        <a href={releases} class="text-zinc-400 hover:text-zinc-200 transition-colors underline underline-offset-2">GitHub</a>.
      </p>
    </div>
  </div>
</BaseLayout>
